# Normalise every text file to LF in the repository and on checkout.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.sf2 binary
*.jar binary
*.so binary
*.aab binary
*.apk binary
*.keystore binary
*.jks binary

# Vendored third-party files stay byte-identical to upstream, so their recorded
# SHA-256 (THIRD_PARTY.md) still matches.
app/src/main/cpp/third_party/** -text
app/src/main/assets/licences/** -text
